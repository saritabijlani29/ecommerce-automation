{
  "name": "amazon-automation",
  "version": "1.0.0",
  "description": "Amazon Playwright Automation Framework using POM",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "bddgen": "npx bddgen",
    "test:bdd": "npx bddgen && npx playwright test",
    "test:headed": "npx bddgen && npx playwright test --headed"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.6.0",
    "@playwright/test": "^1.40.0",
    "playwright-bdd": "^8.4.2",
    "typescript": "^5.0.0"
  }
}